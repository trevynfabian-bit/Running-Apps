# =============================================================================
# Running OS — environment template
# Copy to `.env` and fill in. NEVER commit a populated `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Public origin of the API, used to build OAuth redirect URIs and webhook URLs.
API_PUBLIC_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Production/staging: a real Postgres connection string (Supabase, RDS, Neon...).
# Leave empty in local dev to use the embedded PGlite database at PGLITE_DIR.
DATABASE_URL=
# Embedded Postgres (PGlite) data directory used when DATABASE_URL is empty.
PGLITE_DIR=.data/pglite

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# 32+ byte random string. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
# 32-byte hex key used to encrypt provider OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Mock mode
# -----------------------------------------------------------------------------
# When true, provider adapters return deterministic synthetic data and no
# outbound network calls are made. Lets the whole product run with no creds.
USE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# Strava — https://www.strava.com/settings/api
# SECRETS ARE BACKEND-ONLY. Never expose the client secret to the mobile app.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4000/api/connections/strava/callback
# Arbitrary string you choose; echoed back during webhook subscription validation.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# WHOOP — https://developer.whoop.com
# SECRETS ARE BACKEND-ONLY.
# -----------------------------------------------------------------------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:4000/api/connections/whoop/callback
# Used to verify X-WHOOP-Signature on inbound webhooks.
WHOOP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI coach (optional). Without a key the coach falls back to the deterministic
# template renderer — training decisions never depend on the LLM.
# -----------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# Mobile app (Expo). ONLY values safe to ship inside the app bundle.
# Anything prefixed EXPO_PUBLIC_ is embedded in the binary and is NOT a secret.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
