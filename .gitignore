# modules/health-kit/ios/** is hand-written native source and MUST stay tracked.
.expo/
.expo-shared/
/apps/mobile/ios/
/apps/mobile/android/
*.jsbundle
web-build/

# Local database (PGlite dev data directory)
.data/
*.sqlite
*.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# NgodingPakeAI CLI working file (regenerated by `sync --plan`)
